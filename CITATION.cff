    given-names: Caleb
    orcid: "https://orcid.org/0000-0002-9859-2264"
  - name: HydroCouple Developers
version: "0.2.0"
license: Apache-2.0
repository-code: "https://github.com/HydroCouple/Meshkit"
keywords:
  - mesh generation
  - unstructured mesh
  - constrained Delaunay triangulation
  - quadrilateral mesh
  - two-dimensional surface flow
  - hydrodynamic modeling
references:
